# PNPay-H environment variables - PLACEHOLDERS ONLY. Copy to .env.local and fill in.
# Never commit real values.

# --- Database (managed PostgreSQL: Neon, Supabase, Vercel Postgres, ...) ---
# Use the DIRECT (non-pooled) URL for migrations if your provider offers a pooler.
DATABASE_URL="postgresql://neondb_owner:npg_A0YCTaeEy8BU@ep-little-dew-bc6bgf3e-pooler.c-16.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"


# --- Authentication ---
# Random secret, at least 32 characters. Generate: openssl rand -base64 48
AUTH_SECRET="0K3eS55gXOSsF4DqlcqgqR+jBNPP+CmUOTCDJkeFplcPYgPqCR1jl39otv1TSs7Y"

# --- Application ---
# Public base URL used in email links (no trailing slash)
APP_BASE_URL="https://pnpay-h.vercel.app/"

# --- Email ---
# smtp    = send through any SMTP server with Nodemailer (free option: a Gmail account + APP PASSWORD) - production OK
# resend  = send through Resend (production OK)
# file    = write emails to .dev-mail/ (local development only; never used in production)
EMAIL_PROVIDER="file"
# For smtp with Gmail, EMAIL_FROM must be that Gmail address, e.g. "PNPay-H <yourname@gmail.com>"
EMAIL_FROM="PNPay-H <no-reply@example.com>"

# EMAIL_PROVIDER=smtp settings (Gmail: smtp.gmail.com, 465, true). Use a Google "App password" (needs 2-step verification), NOT your login password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="pnpayh@gmail.com"
SMTP_PASS="olvy eojm xcyy opel"

# --- Receipt storage (Phase 2) ---
# vercel-blob = private Vercel Blob store (REQUIRED in production)
# local       = files under ./.dev-receipts (development only; refused in production)
# memory      = tests only
RECEIPT_STORAGE="local"
# Required when RECEIPT_STORAGE=vercel-blob. Create a PRIVATE Blob store in Vercel and connect it to the project.
BLOB_READ_WRITE_TOKEN="placeholder"
# Max receipt size in bytes (default 10485760 = 10 MB)
RECEIPT_MAX_BYTES=10485760
# Optional folder for RECEIPT_STORAGE=local
# RECEIPT_LOCAL_DIR=".dev-receipts"
# TEST ONLY (E2E suite). Never set on Vercel.
# ALLOW_NON_PRODUCTION_STORAGE=1

# --- Scheduled jobs and reminders (Phase 4) ---
# Shared secret for /api/cron/*. Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>" when this
# variable exists on the project. Without it the job routes refuse to run (fail closed). Generate: openssl rand -base64 48
CRON_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
# LLD 11.4 default: remind this many days before the due date (1-30). Confirm with Miss Jean (OPEN-9).
REMINDER_DAYS_BEFORE=5
# Overdue notices stay OFF (0) until Miss Jean approves the rule (OPEN-15). 1 = send ONE notice per overdue unpaid installment.
OVERDUE_REMINDERS_ENABLED=0

# --- Controlled admin setup (read ONLY by `npm run admin:create`, never by the web app) ---
ADMIN_FULL_NAME="Miss Jean"
ADMIN_EMAIL="pnpayh@gmail.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"
